# Image Spark 3.5 du projet SahlPay.
# Elle part de bitnami/spark:3.5 et ajoute les JAR necessaires au projet,
# telecharges une fois a la construction (pas de --packages a l'execution,
# donc pas de resolution Ivy a chaque soumission de job).
FROM bitnami/spark:3.5

USER root

# Versions alignees sur Spark 3.5 / Scala 2.12 / Hadoop 3.3.4
ENV HADOOP_AWS_VERSION=3.3.4 \
    AWS_SDK_VERSION=1.12.262 \
    SPARK_KAFKA_VERSION=3.5.1 \
    KAFKA_CLIENTS_VERSION=3.5.1 \
    COMMONS_POOL2_VERSION=2.11.1 \
    DELTA_VERSION=3.2.0 \
    GRAPHFRAMES_VERSION=0.8.3-spark3.5-s_2.12

WORKDIR /opt/bitnami/spark/jars

RUN set -eux; \
    M2=https://repo1.maven.org/maven2; \
    curl -fsSLO ${M2}/org/apache/hadoop/hadoop-aws/${HADOOP_AWS_VERSION}/hadoop-aws-${HADOOP_AWS_VERSION}.jar; \
    curl -fsSLO ${M2}/com/amazonaws/aws-java-sdk-bundle/${AWS_SDK_VERSION}/aws-java-sdk-bundle-${AWS_SDK_VERSION}.jar; \
    # --- Kafka (Partie 4/5, deja present pour le jalon 2) ---
    curl -fsSLO ${M2}/org/apache/spark/spark-sql-kafka-0-10_2.12/${SPARK_KAFKA_VERSION}/spark-sql-kafka-0-10_2.12-${SPARK_KAFKA_VERSION}.jar; \
    curl -fsSLO ${M2}/org/apache/spark/spark-token-provider-kafka-0-10_2.12/${SPARK_KAFKA_VERSION}/spark-token-provider-kafka-0-10_2.12-${SPARK_KAFKA_VERSION}.jar; \
    curl -fsSLO ${M2}/org/apache/kafka/kafka-clients/${KAFKA_CLIENTS_VERSION}/kafka-clients-${KAFKA_CLIENTS_VERSION}.jar; \
    curl -fsSLO ${M2}/org/apache/commons/commons-pool2/${COMMONS_POOL2_VERSION}/commons-pool2-${COMMONS_POOL2_VERSION}.jar; \
    # --- Delta Lake (Partie 5) ---
    curl -fsSLO ${M2}/io/delta/delta-spark_2.12/${DELTA_VERSION}/delta-spark_2.12-${DELTA_VERSION}.jar; \
    curl -fsSLO ${M2}/io/delta/delta-storage/${DELTA_VERSION}/delta-storage-${DELTA_VERSION}.jar; \
    # --- GraphFrames (Partie 6) ---
    curl -fsSL -o graphframes-${GRAPHFRAMES_VERSION}.jar \
      https://repos.spark-packages.org/graphframes/graphframes/${GRAPHFRAMES_VERSION}/graphframes-${GRAPHFRAMES_VERSION}.jar

# Dependances Python du driver / des workers
COPY requirements-spark.txt /tmp/requirements-spark.txt
RUN pip install --no-cache-dir -r /tmp/requirements-spark.txt

# Configuration Spark commune (S3A vers MinIO, event log, Delta)
COPY spark-defaults.conf /opt/bitnami/spark/conf/spark-defaults.conf

RUN mkdir -p /opt/sahlpay/spark-events && chmod -R 777 /opt/sahlpay

USER 1001
WORKDIR /opt/bitnami/spark
